    local rootPosition = root.Position
    local hrp2D, onScreen = camera:WorldToViewportPoint(rootPosition)
    if not onScreen or hrp2D.Z <= 0 then utility.funcs.clear_esp(player,record); return end
    local distance = record.PreviewDistance
    if distance == nil and (settings.Distance.Enabled or settings.DistanceLimit.Enabled) then distance = (rootPosition - (frame.ClientPosition or camera.CFrame.Position)).Magnitude end
    if settings.DistanceLimit.Enabled and distance > settings.DistanceLimit.MaxDistance then utility.funcs.clear_esp(player,record); return end
    local color = settings.Target.Enabled and (ESP.ActiveTarget == player or record.Preview and ESP.ActiveTarget ~= nil) and settings.Target.Color or nil
    local protected = false
    if settings.ForceField.Enabled then
        if record.SourceCharacter and record.SourceCharacter ~= character then protected = ESP:HasForceField(record.SourceCharacter)
        else
            local forceField, value = record.ForceFieldInstance, record.ForceFieldValue
            protected = forceField and forceField.Parent == character or value and value.Parent == character and value:IsA('BoolValue') and value.Value == true or false
        end
    end
    if not frame.TwoDimensional then
        record.Rendering = true
        if record.DrawingVisible then for _, draw in pairs(record.Drawings) do draw.Visible = false end; record.DrawingVisible = false end
        effects(player,record,protected,color)
        return
    end
    local charSize = (camera:WorldToViewportPoint(rootPosition - lowerOffset).Y - camera:WorldToViewportPoint(rootPosition + upperOffset).Y) / 2
    if charSize <= 0 or charSize ~= charSize then utility.funcs.clear_esp(player,record); return end
    local size = Vector2.new(floor(charSize * 1.5),floor(charSize * 3.2))
    local position = Vector2.new(floor(hrp2D.X - charSize * 1.5 / 2),floor(hrp2D.Y - charSize * 3 / 2))
    local spacing = record.PhowgBarSpacing or emptyBarSpacing
    local topSpace, bottomSpace, rightSpace = spacing.Top or 0, spacing.Bottom or 0, math.max(4,spacing.Right or 0)
    record.PhowgAppliedBarSpacing = spacing
    utility.funcs.render(player,record)
    local draws = record.Drawings
    record.DrawingVisible = true
    record.LayoutPosition, record.LayoutSize, record.Rendering = position, size, true
    local health, maxHealth = humanoid.Health, humanoid.MaxHealth
    record.Fake_Health, record.Fake_MaxHealth = health, math.max(1,maxHealth)
    record.Fake_Armor = record.ArmorValue and record.ArmorValue.Parent and record.ArmorValue.Value or 0
    local fading = settings.Animation.Mode == 'fading'
    local opacity = fading and math.min(1,(record.Opacity or 0) + frame.Delta * 8) or 1
    record.Opacity = opacity
    if record.DrawingOpacity ~= opacity then
        for name, draw in pairs(draws) do if name ~= 'Image' then draw.Transparency = opacity end end
        record.DrawingOpacity = opacity
    end
    local boxEnabled = settings.Box.Enabled
    draws.Box.Visible, draws.BoxOutline.Visible, draws.BoxInline.Visible = boxEnabled, boxEnabled, boxEnabled
    if boxEnabled then
        draws.Box.Position, draws.Box.Size, draws.Box.Color, draws.Box.Thickness = position, size, color or settings.Box.Colors.Top, settings.Box.Thickness
        draws.BoxOutline.Position, draws.BoxOutline.Size = position - one2D, size + two2D
        draws.BoxInline.Position, draws.BoxInline.Size = position + one2D, size - two2D
    end
    draws.Image.Visible = settings.Image.Enabled
    if settings.Image.Enabled then
        draws.Image.Position, draws.Image.Size, draws.Image.Color, draws.Image.Transparency = position, size, color or settings.Image.Color or white, 0.15 * opacity
        local gradientEnabled = settings.Image.Data == 'Gradient'
        if record.ImageGradientEnabled ~= gradientEnabled then record.ImageGradient.Enabled, record.ImageGradientEnabled = gradientEnabled, gradientEnabled end
    end
    if settings.Name.Enabled then
        local both, display, username = settings.Name.Use_Both_Name, settings.Name.Use_Display_Name, player.Name
        if record.NameBoth ~= both or record.NameDisplay ~= display or record.PlayerName ~= username or record.DisplayName ~= player.DisplayName or not record.NameText then
            record.NameBoth, record.NameDisplay, record.PlayerName, record.DisplayName = both, display, username, player.DisplayName
            record.NameText = both and (player.DisplayName .. ' (@' .. username .. ')') or display and player.DisplayName or username
        end
        label(draws.Name,true,record.NameText,position + Vector2.new(size.X/2,-settings.Misc.MainSize-4-topSpace),color or settings.Name.Color,settings.Misc.MainSize)
    else draws.Name.Visible = false end
    local below = size.Y + 4 + bottomSpace
    if settings.Distance.Enabled then
        if record.DistanceValue ~= distance then record.DistanceValue, record.DistanceText = distance, string.format('[%.0fm]',distance * 0.28) end
        label(draws.Distance,true,record.DistanceText,position + Vector2.new(size.X/2,below),color or settings.Distance.Color,settings.Misc.SmallSize)
        below = below + 14
    else draws.Distance.Visible = false end
    local tool = record.EquippedTool
    if settings.ToolText.Enabled then
        label(draws.ToolText,true,tool and tool.Name or 'none',position + Vector2.new(size.X/2,below),color or settings.ToolText.Color,settings.Misc.SmallSize)
        below = below + 14
    else draws.ToolText.Visible = false end
    local weaponVisible = false
    if settings.WeaponIcon.Enabled and tool then
        if record.IconToolName ~= tool.Name then record.IconToolName, record.IconKey = tool.Name, IconKey(tool.Name) end
        local image = GetIconData(record.IconKey)
        if image then
            draws.WeaponIcon.Data, draws.WeaponIcon.Position, draws.WeaponIcon.Size, draws.WeaponIcon.Color = image, position + Vector2.new(size.X/2-20,below), Vector2.new(40,20), color or settings.WeaponIcon.Color
            weaponVisible = true
        end
    end
    draws.WeaponIcon.Visible = weaponVisible
    local crew = ESP.CrewNames[player]
    local crewOn = settings.Crew.Enabled and type(crew) == 'string' and crew ~= ''
    if crewOn then label(draws.CrewText,true,crew,position + Vector2.new(size.X/2,-32-topSpace),color or settings.Crew.Color,settings.Misc.SmallSize) else draws.CrewText.Visible = false end
    local crewId = ESP.CrewIds[player]
    if crewOn and settings.Crew.Count then label(draws.CrewCount,true,'[' .. tostring(ESP.CrewCounts[crewId] or 0) .. ']',position + Vector2.new(size.X+4,-32-topSpace),color or settings.Crew.Color,settings.Misc.SmallSize) else draws.CrewCount.Visible = false end
    local icon = crewId and ESP.CrewIcons[crewId]
    local crewIconVisible = crewOn and type(icon) == 'string' and icon ~= ''
    if crewIconVisible then draws.CrewIcon.Data, draws.CrewIcon.Position, draws.CrewIcon.Size = icon, position + Vector2.new(-18,-32-topSpace), Vector2.new(14,14) end
    draws.CrewIcon.Visible = crewIconVisible == true
    for index, kind in ipairs(barKinds) do
        local barSettings, value = settings.Bars[kind], kind == 'Health' and record.Fake_Health or record.Fake_Armor
        local bar, outline = draws[kind .. 'Bar'], draws[kind .. 'BarOutline']
        local shown = barSettings.Enabled and (kind ~= 'Armor' or not barSettings.Hide_If_Empty or value > 0)
        bar.Visible, outline.Visible = shown, shown
        if shown and not ESP.PhowgRenderBars then
            local maximum = kind == 'Health' and record.Fake_MaxHealth or 130
            local ratio = clamp(value/maximum,0,1)
            local prior = record['Last' .. kind] or ratio
            local smooth = prior + (ratio-prior) * frame.SmoothAlpha
            record['Last' .. kind] = smooth
            local x = position.X - (index == 1 and 7 or 13)
            outline.Position, outline.Size = Vector2.new(x-1,position.Y-1), Vector2.new(5,size.Y+2)
            bar.Position, bar.Size, bar.Color = Vector2.new(x,position.Y+(1-smooth)*size.Y), Vector2.new(3,smooth*size.Y), barSettings.Gradient and white or color or barSettings.BaseColor or barSettings.Colors[1]
            ESP:SetBarGradient(record,kind,color or barSettings.BaseColor or barSettings.Colors[1],color or barSettings.GradientColor or barSettings.Colors[2] or bar.Color,false,false,0)
        end
    end
    if settings.HealthText.Enabled and (not settings.HealthText.HideFullHealth or health < maxHealth) then label(draws.HealthText,true,tostring(floor(health)),position + (spacing.HealthText or defaultHealthTextOffset),color or settings.HealthText.Color,settings.Misc.SmallSize) else draws.HealthText.Visible = false end
    local wanted = 0
    if settings.Wanted.Enabled and frame.Wanted then local ok, value = pcall(frame.Wanted,player); if ok then wanted = tonumber(value) or 0 end end
    if settings.Wanted.Enabled and wanted > 0 then label(draws.WantedText,true,'WANTED / ' .. tostring(floor(wanted)),position + Vector2.new(size.X+rightSpace,0),color or settings.Wanted.Color,settings.Misc.SmallSize) else draws.WantedText.Visible = false end
    if settings.ForceField.Enabled and protected then label(draws.ForceFieldText,true,'FORCEFIELD',position + Vector2.new(size.X+rightSpace,14),settings.ForceField.Color,settings.Misc.SmallSize) else draws.ForceFieldText.Visible = false end
    local tracerEnabled, outlineEnabled = settings.Tracer.Enabled, settings.Tracer.Enabled and settings.Tracer.Outline
    draws.Tracer.Visible, draws.TracerOutline.Visible = tracerEnabled, outlineEnabled
    if tracerEnabled then
        local from, to = record.TracerOrigin or frame.TracerOrigin, position + Vector2.new(size.X/2,size.Y/2)
        draws.Tracer.Color, draws.Tracer.Thickness = color or settings.Tracer.Color, 1
        draws.Tracer:SetEndpoints(from,to)
        if outlineEnabled then draws.TracerOutline.Color, draws.TracerOutline.Thickness = black, 3; draws.TracerOutline:SetEndpoints(from,to) end
    end
    effects(player,record,protected,color)
    if ESP.PhowgRenderBars then ESP.PhowgRenderBars(ESP,player,record,frame.Now) end
end
function ESP:Configure(config)
    local function merge(target, source)
        for key, value in pairs(source) do
            if type(value) == 'table' and type(target[key]) == 'table' then merge(target[key],value) else target[key] = value end
        end
    end
    merge(self.Settings,config)
    enabled = false
    for _, key in ipairs({'Box','Name','Crew','Distance','Chams','Highlight','ToolText','WeaponIcon','HealthText','Wanted','ForceField','Tracer','Image'}) do if self.Settings[key].Enabled then enabled = true; break end end
    enabled = enabled or self.Settings.Bars.Health.Enabled or self.Settings.Bars.Armor.Enabled
    revision = revision + 1
    if not enabled then for player, record in pairs(cache) do utility.funcs.clear_esp(player,record) end end
end
function ESP:Refresh() revision = revision + 1 end
function ESP:Update_ESP_Color() self:Refresh() end
function ESP:FadeAll() for _, record in pairs(cache) do record.Opacity = 0 end end
function ESP:HidePreview(key) utility.funcs.clear_esp(nil,self.Previews[key]) end
function ESP:DestroyPreview(key)
    local record = self.Previews[key]
    if record then destroy(record); self.Previews[key] = nil end
end
function ESP:RenderPreview(key, player, character, viewCamera, position, size)
    local source = player.Character or character
    local humanoid = source and source:FindFirstChildOfClass('Humanoid')
    if not character or not humanoid or size.X < 10 or size.Y < 10 then self:HidePreview(key); return end
    local record = self.Previews[key]
    if record and record.Character ~= character then self:DestroyPreview(key); record = nil end
    if not record then
        record = {Player = player, Preview = true, Connections = {}}
        self.Previews[key] = record
        bind(record,character)
    end
    record.SourceCharacter, record.Humanoid, record.ArmorValue = source, humanoid, getArmor(source)
    record.EquippedTool = source:FindFirstChildOfClass('Tool')
    local projection = record.PreviewCamera
    if not projection then
        projection = {}
        function projection:WorldToViewportPoint(world)
            local point = self.Camera.CFrame:PointToObjectSpace(world)
            local depth = -point.Z
            if depth <= 0.01 then return Vector3.new(0,0,depth),false end
            local focal = self.Size.Y / (2 * math.tan(math.rad(self.Camera.FieldOfView)/2))
            local x, y = self.Position.X+self.Size.X/2+point.X*focal/depth, self.Position.Y+self.Size.Y/2-point.Y*focal/depth
            return Vector3.new(x,y,depth), x>=self.Position.X and x<=self.Position.X+self.Size.X and y>=self.Position.Y and y<=self.Position.Y+self.Size.Y
        end
        record.PreviewCamera = projection
    end
    projection.Camera, projection.Position, projection.Size, projection.CFrame, projection.ViewportSize = viewCamera, position, size, viewCamera.CFrame, size
    record.TracerOrigin, record.PreviewDistance = position + Vector2.new(size.X/2,size.Y), 0
    utility.funcs.update(player,record,1/60)
end
for _, player in ipairs(Players:GetPlayers()) do track(player) end
connect(Players.PlayerAdded,track,Players,'unnamed player added')
connect(Players.PlayerRemoving,function(player)
    if cache[player] then destroy(cache[player]); cache[player] = nil end
    ESP.CrewNames[player], ESP.CrewIds[player] = nil, nil
end,Players,'unnamed player removed')
connect(RunService.Heartbeat,function(delta)
    if not alive or not enabled then return end
    local frame = frameContext(delta)
    for player, record in pairs(cache) do
        local ok, err = pcall(utility.funcs.update,player,record,delta,frame)
        if not ok then
            utility.funcs.clear_esp(player,record)
            if tick()-(record.ErrorAt or -math.huge)>5 then record.ErrorAt = tick(); warn('[Phowg] unnamed ESP: ' .. tostring(err)) end
        end
    end
end,RunService,'unnamed render')
ESP._Cleanup = function()
    if not alive then return end
    alive = false
    for _, connection in ipairs(connections) do connection:Disconnect() end
    for _, record in pairs(cache) do destroy(record) end
    for key in pairs(ESP.Previews) do ESP:DestroyPreview(key) end
    table.clear(cache)
    gui:Destroy()
end
ESP.Cache, ESP.Utility = cache, utility
return ESP
