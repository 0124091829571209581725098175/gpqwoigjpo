local IconsURL = "https://raw.githubusercontent.com/0124091829571209581725098175/23023095823059230523/refs/heads/main/32980507239805723"
local sharedIcons = getgenv().PhowgESPIcons or {Cache = {}}
getgenv().PhowgESPIcons = sharedIcons
local IconTable, IconCache = sharedIcons.Table, sharedIcons.Cache
local IconPending, IconRetryAt = false, 0
local function IconKey(ToolName)
    if not ToolName then
        return nil
    end
    local Key = string.lower(tostring(ToolName))
    Key = string.gsub(Key, "[%[%]]", "")
    Key = string.gsub(Key, "-", "")
    Key = string.gsub(Key, "%s+", "")
    if Key == "rpg" then
        Key = "rpg_icon"
    end
    if Key == "grenade" then
        Key = "grenade_icon"
    end
    if string.match(Key, "^[a-z0-9_]+$") then
        return Key
    end
    return nil
end
local function FetchIcons()
    if IconTable ~= nil or IconPending or tick() < IconRetryAt then
        return
    end
    IconPending = true
    task.spawn(function()
        if game.HttpGet then
            local Ok, Raw = pcall(function() return game:HttpGet(IconsURL) end)
            if Ok and type(Raw) == "string" and #Raw > 100 then
                local Loader = loadstring or load
                if Loader ~= nil then
                    local Ok2, Fn = pcall(Loader, Raw .. "\nreturn images")
                    if Ok2 and Fn then
                        local Ok3, Table = pcall(Fn)
                        if Ok3 and type(Table) == "table" then
                            IconTable, sharedIcons.Table = Table, Table
                        end
                    end
                end
            end
        end
        IconPending, IconRetryAt = false, tick() + 10
    end)
end
local function GetIconData(Key)
    if not Key then
        return nil
    end
    if IconCache[Key] ~= nil then
        return IconCache[Key]
    end
    if IconTable == nil then
        FetchIcons()
        return nil
    end
    local Entry = IconTable[Key]
    if type(Entry) ~= "string" or #Entry < 100 then
        return nil
    end
    local Ok, Decoded = pcall(base64_decode, Entry)
    if Ok and type(Decoded) == "string" and #Decoded > 0 then
        IconCache[Key] = Decoded
        return Decoded
    end
    return nil
end
function utility.funcs.update(player, record, delta)
    record = record or cache[player]
    if not record then return end
    if not enabled or player == LocalPlayer and not ESP.Settings.Self.Enabled and not record.Preview then utility.funcs.clear_esp(player,record); return end
    local character = record.Character
    local root, humanoid = record.Root, record.Humanoid
    local camera = record.PreviewCamera or Workspace.CurrentCamera
    if not character or not character.Parent or not root or not root.Parent or not humanoid or not camera or humanoid.Health <= 0 then utility.funcs.clear_esp(player,record); return end
    local hrp2D, onScreen = camera:WorldToViewportPoint(root.Position)
    if not onScreen or hrp2D.Z <= 0 then utility.funcs.clear_esp(player,record); return end
    local clientPosition = getgenv().PhowgClientPos
    if typeof(clientPosition) == 'CFrame' then clientPosition = clientPosition.Position end
    if typeof(clientPosition) ~= 'Vector3' then clientPosition = camera.CFrame.Position end
    local distance = record.PreviewDistance or (root.Position - clientPosition).Magnitude
    local settings = ESP.Settings
    if settings.DistanceLimit.Enabled and distance > settings.DistanceLimit.MaxDistance then utility.funcs.clear_esp(player,record); return end
    local charSize = (camera:WorldToViewportPoint(root.Position - Vector3.new(0,1,0)).Y - camera:WorldToViewportPoint(root.Position + Vector3.new(0,3,0)).Y) / 2
    if charSize <= 0 or charSize ~= charSize then utility.funcs.clear_esp(player,record); return end
    local size = Vector2.new(floor(charSize * 1.5),floor(charSize * 3.2))
    local position = Vector2.new(floor(hrp2D.X - charSize * 1.5 / 2),floor(hrp2D.Y - charSize * 3 / 2))
    utility.funcs.render(player,record)
    local draws = record.Drawings
    record.LayoutPosition, record.LayoutSize, record.Rendering = position, size, true
    record.Fake_Health, record.Fake_MaxHealth = humanoid.Health, math.max(1,humanoid.MaxHealth)
    record.Fake_Armor = record.ArmorValue and record.ArmorValue.Parent and record.ArmorValue.Value or 0
    local color = settings.Target.Enabled and (ESP.ActiveTarget == player or record.Preview and ESP.ActiveTarget ~= nil) and settings.Target.Color or nil
    local fading = settings.Animation.Mode == 'fading'
    local opacity = fading and math.min(1,(record.Opacity or 0) + (delta or 1/60) * 8) or 1
    record.Opacity = opacity
    for _, draw in pairs(draws) do draw.Transparency = opacity end
    draws.Box.Visible, draws.BoxOutline.Visible, draws.BoxInline.Visible = settings.Box.Enabled, settings.Box.Enabled, settings.Box.Enabled
    draws.Box.Position, draws.Box.Size, draws.Box.Color, draws.Box.Thickness = position, size, color or settings.Box.Colors.Top, settings.Box.Thickness
    draws.BoxOutline.Position, draws.BoxOutline.Size = position - Vector2.new(1,1), size + Vector2.new(2,2)
    draws.BoxInline.Position, draws.BoxInline.Size = position + Vector2.new(1,1), size - Vector2.new(2,2)
    draws.Image.Visible, draws.Image.Position, draws.Image.Size, draws.Image.Color, draws.Image.Transparency = settings.Image.Enabled, position, size, color or settings.Image.Color or white, 0.15 * opacity
    record.ImageGradient.Enabled = settings.Image.Data == 'Gradient'
    local name = settings.Name.Use_Both_Name and (player.DisplayName .. ' (@' .. player.Name .. ')') or settings.Name.Use_Display_Name and player.DisplayName or player.Name
    label(draws.Name,settings.Name.Enabled,name,position + Vector2.new(size.X/2,-settings.Misc.MainSize-4),color or settings.Name.Color,settings.Misc.MainSize)
    local below = size.Y + 4
    label(draws.Distance,settings.Distance.Enabled,string.format('[%.0fm]',distance * 0.28),position + Vector2.new(size.X/2,below),color or settings.Distance.Color,settings.Misc.SmallSize)
    if settings.Distance.Enabled then below = below + 14 end
