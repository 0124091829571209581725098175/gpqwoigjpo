        local image = GetIconData(IconKey(tool.Name))
        if image then draws.WeaponIcon.Data, draws.WeaponIcon.Position, draws.WeaponIcon.Size, draws.WeaponIcon.Color, draws.WeaponIcon.Visible = image, position + Vector2.new(size.X/2-20,below), Vector2.new(40,20), color or settings.WeaponIcon.Color, true end
    end
    local crew = ESP.CrewNames[player]
