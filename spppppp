    for _, connection in ipairs(record.CharacterConnections or {}) do connection:Disconnect() end
    for _, object in pairs(record.Drawings or {}) do object:Remove() end
    for _, object in pairs(record.Chams or {}) do object:Destroy() end
    if record.Highlight then record.Highlight:Destroy() end
    if record.ForceFieldBubble then record.ForceFieldBubble:Destroy() end
end
