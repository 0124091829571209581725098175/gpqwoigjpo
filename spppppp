    if not gradient then return end
    local colors = record.GradientColors or {}; record.GradientColors = colors
    local previous = colors[kind]
    if not previous then previous = {}; colors[kind] = previous end
    if previous.First ~= first or previous.Last ~= last or previous.Shift ~= shift then
        local start, finish = first, last
        if shift and math.abs(shift) > 0.001 then start = first:Lerp(last,math.max(0,shift)); finish = last:Lerp(first,math.max(0,-shift)) end
        gradient.Color = ColorSequence.new(start,finish)
        previous.First, previous.Last, previous.Shift = first, last, shift
    end
