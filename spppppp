                adornment.Size, adornment.Color3, adornment.Transparency, adornment.Visible = part.Size + settings.Chams.Offset, color or settings.Chams.Color, settings.Chams.Transparency, true
            end
        end
    else for _, adornment in pairs(record.Chams) do adornment.Visible = false end end
    if settings.Highlight.Enabled then
        if not record.Highlight then record.Highlight = Instance.new('Highlight'); record.Highlight.Parent = record.Character end
        local highlight = record.Highlight
        highlight.Adornee, highlight.Enabled, highlight.DepthMode = record.Character, true, settings.Highlight.DepthMode
        highlight.FillColor, highlight.OutlineColor, highlight.FillTransparency, highlight.OutlineTransparency = color or settings.Highlight.FillColor, color or settings.Highlight.OutlineColor, settings.Highlight.FillTransparency, settings.Highlight.OutlineTransparency
    elseif record.Highlight then record.Highlight.Enabled = false end
    if protected and settings.ForceField.Enabled then
        if not record.ForceFieldBubble then record.ForceFieldBubble = Instance.new('SphereHandleAdornment'); record.ForceFieldBubble.Parent = record.Character end
        local bubble = record.ForceFieldBubble
        bubble.Adornee, bubble.Radius, bubble.AlwaysOnTop, bubble.ZIndex = root, 4, true, 1
        bubble.Color3, bubble.Transparency, bubble.Visible = settings.ForceField.Color, settings.ForceField.Transparency, true
    elseif record.ForceFieldBubble then record.ForceFieldBubble.Visible = false end
