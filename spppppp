    label(draws.CrewCount,crewOn and settings.Crew.Count,'[' .. tostring(ESP.CrewCounts[crewId] or 0) .. ']',position + Vector2.new(size.X+4,-32),color or settings.Crew.Color,settings.Misc.SmallSize)
    local icon = crewId and ESP.CrewIcons[crewId]
