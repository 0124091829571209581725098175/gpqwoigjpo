    if crewOn and type(icon) == 'string' and icon ~= '' then
        draws.CrewIcon.Data, draws.CrewIcon.Position, draws.CrewIcon.Size, draws.CrewIcon.Visible = icon, position + Vector2.new(-18,-32), Vector2.new(14,14), true
    end
    for index, kind in ipairs({'Health','Armor'}) do
        local barSettings, value = settings.Bars[kind], kind == 'Health' and record.Fake_Health or record.Fake_Armor
        local bar, outline = draws[kind .. 'Bar'], draws[kind .. 'BarOutline']
        local shown = barSettings.Enabled and (kind ~= 'Armor' or not barSettings.Hide_If_Empty or value > 0)
        bar.Visible, outline.Visible = shown, shown
        if shown and not ESP.PhowgRenderBars then
            local maximum = kind == 'Health' and record.Fake_MaxHealth or 130
            local ratio = clamp(value/maximum,0,1)
            local prior = record['Last' .. kind] or ratio
            local smooth = prior + (ratio-prior) * (1-exp(-(delta or 1/60)*3))
            record['Last' .. kind] = smooth
            local x = position.X - (index == 1 and 7 or 13)
            outline.Position, outline.Size = Vector2.new(x-1,position.Y-1), Vector2.new(5,size.Y+2)
            bar.Position, bar.Size, bar.Color = Vector2.new(x,position.Y+(1-smooth)*size.Y), Vector2.new(3,smooth*size.Y), barSettings.Gradient and white or color or barSettings.BaseColor or barSettings.Colors[1]
            ESP:SetBarGradient(record,kind,color or barSettings.BaseColor or barSettings.Colors[1],color or barSettings.GradientColor or barSettings.Colors[2] or bar.Color,false,false,0)
        end
    end
    label(draws.HealthText,settings.HealthText.Enabled and (not settings.HealthText.HideFullHealth or humanoid.Health < humanoid.MaxHealth),tostring(floor(humanoid.Health)),position + Vector2.new(-28,0),color or settings.HealthText.Color,settings.Misc.SmallSize)
    local wanted = 0
    if settings.Wanted.Enabled then
        local fn = getgenv().PhowgGetWanted
        if fn then local ok, value = pcall(fn,player); if ok then wanted = tonumber(value) or 0 end end
    end
    label(draws.WantedText,settings.Wanted.Enabled and wanted > 0,'WANTED / ' .. tostring(floor(wanted)),position + Vector2.new(size.X+4,0),color or settings.Wanted.Color,settings.Misc.SmallSize)
    local protected = ESP:HasForceField(record.SourceCharacter or character)
    label(draws.ForceFieldText,settings.ForceField.Enabled and protected,'FORCEFIELD',position + Vector2.new(size.X+4,14),settings.ForceField.Color,settings.Misc.SmallSize)
    draws.Tracer.Visible, draws.TracerOutline.Visible = settings.Tracer.Enabled, settings.Tracer.Enabled and settings.Tracer.Outline
    if settings.Tracer.Enabled then
        local from = record.TracerOrigin
        if not from then
            local viewport, origin = camera.ViewportSize, settings.Tracer.Origin
            if origin == 'Mouse' then from = game:GetService('UserInputService'):GetMouseLocation()
            elseif origin == 'Center' then from = Vector2.new(viewport.X/2,viewport.Y/2)
            elseif origin == 'Below' then from = Vector2.new(viewport.X/2,viewport.Y)
            else from = Vector2.new(viewport.X/2,0) end
        end
        local to = position + Vector2.new(size.X/2,size.Y/2)
        draws.Tracer.From, draws.Tracer.To, draws.Tracer.Color, draws.Tracer.Thickness = from, to, color or settings.Tracer.Color, 1
        draws.TracerOutline.From, draws.TracerOutline.To, draws.TracerOutline.Color, draws.TracerOutline.Thickness = from, to, black, 3
    end
    effects(player,record,protected,color)
    if ESP.PhowgRenderBars then ESP.PhowgRenderBars(ESP,player,record,tick()) end
end
function ESP:Configure(config)
    local function merge(target, source)
        for key, value in pairs(source) do
            if type(value) == 'table' and type(target[key]) == 'table' then merge(target[key],value) else target[key] = value end
        end
    end
    merge(self.Settings,config)
    enabled = false
    for _, key in ipairs({'Box','Name','Crew','Distance','Chams','Highlight','ToolText','WeaponIcon','HealthText','Wanted','ForceField','Tracer','Image'}) do if self.Settings[key].Enabled then enabled = true; break end end
    enabled = enabled or self.Settings.Bars.Health.Enabled or self.Settings.Bars.Armor.Enabled
    revision = revision + 1
    if not enabled then for player, record in pairs(cache) do utility.funcs.clear_esp(player,record) end end
end
function ESP:Refresh() revision = revision + 1 end
function ESP:Update_ESP_Color() self:Refresh() end
function ESP:FadeAll() for _, record in pairs(cache) do record.Opacity = 0 end end
function ESP:HidePreview(key) utility.funcs.clear_esp(nil,self.Previews[key]) end
function ESP:DestroyPreview(key)
    local record = self.Previews[key]
    if record then destroy(record); self.Previews[key] = nil end
end
function ESP:RenderPreview(key, player, character, viewCamera, position, size)
    local source = player.Character or character
    local humanoid = source and source:FindFirstChildOfClass('Humanoid')
    if not character or not humanoid or size.X < 10 or size.Y < 10 then self:HidePreview(key); return end
    local record = self.Previews[key]
    if record and record.Character ~= character then self:DestroyPreview(key); record = nil end
    if not record then
        record = {Player = player, Preview = true, Connections = {}}
        self.Previews[key] = record
        bind(record,character)
    end
    record.SourceCharacter, record.Humanoid, record.ArmorValue = source, humanoid, getArmor(source)
    record.EquippedTool = source:FindFirstChildOfClass('Tool')
    local projection = record.PreviewCamera
    if not projection then
        projection = {}
        function projection:WorldToViewportPoint(world)
            local point = self.Camera.CFrame:PointToObjectSpace(world)
            local depth = -point.Z
            if depth <= 0.01 then return Vector3.new(0,0,depth),false end
            local focal = self.Size.Y / (2 * math.tan(math.rad(self.Camera.FieldOfView)/2))
            local x, y = self.Position.X+self.Size.X/2+point.X*focal/depth, self.Position.Y+self.Size.Y/2-point.Y*focal/depth
            return Vector3.new(x,y,depth), x>=self.Position.X and x<=self.Position.X+self.Size.X and y>=self.Position.Y and y<=self.Position.Y+self.Size.Y
        end
        record.PreviewCamera = projection
    end
    projection.Camera, projection.Position, projection.Size, projection.CFrame, projection.ViewportSize = viewCamera, position, size, viewCamera.CFrame, size
    record.TracerOrigin, record.PreviewDistance = position + Vector2.new(size.X/2,size.Y), 0
    utility.funcs.update(player,record,1/60)
end
for _, player in ipairs(Players:GetPlayers()) do track(player) end
connect(Players.PlayerAdded,track,Players,'unnamed player added')
connect(Players.PlayerRemoving,function(player)
    if cache[player] then destroy(cache[player]); cache[player] = nil end
    ESP.CrewNames[player], ESP.CrewIds[player] = nil, nil
end,Players,'unnamed player removed')
connect(RunService.Heartbeat,function(delta)
    if not alive or not enabled then return end
    for player, record in pairs(cache) do
        local ok, err = pcall(utility.funcs.update,player,record,delta)
        if not ok then
            utility.funcs.clear_esp(player,record)
            if tick()-(record.ErrorAt or -math.huge)>5 then record.ErrorAt = tick(); warn('[Phowg] unnamed ESP: ' .. tostring(err)) end
        end
    end
end,RunService,'unnamed render')
ESP._Cleanup = function()
    if not alive then return end
    alive = false
    for _, connection in ipairs(connections) do connection:Disconnect() end
    for _, record in pairs(cache) do destroy(record) end
    for key in pairs(ESP.Previews) do ESP:DestroyPreview(key) end
    table.clear(cache)
    gui:Destroy()
end
ESP.Cache, ESP.Utility = cache, utility
return ESP
