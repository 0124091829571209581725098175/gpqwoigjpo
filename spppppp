    local draws = record.Drawings
    for _, name in ipairs({'Box','BoxOutline','BoxInline'}) do draws[name] = drawing('Square'); draws[name].ZIndex = 3 end
    for _, name in ipairs({'Name','Distance','ToolText','HealthText','WantedText','ForceFieldText','CrewText','CrewCount'}) do draws[name] = drawing('Text'); draws[name].ZIndex = 5; draws[name].Center = name == 'Name' or name == 'Distance' or name == 'ToolText' or name == 'CrewText' end
