local function drawing(kind, owner)
    local native
    if (kind == 'Image') and Drawing and Drawing.new then
        local ok, result = pcall(function() return Drawing.new('Image') end)
        if ok then native = result end
    end
    local item = native or widget(kind == 'Text' and 'TextLabel' or kind == 'Image' and 'ImageLabel' or 'Frame',owner)
    local stroke
    if kind == 'Text' then
        item.Font, item.TextSize, item.TextColor3, item.TextStrokeColor3, item.TextStrokeTransparency = Enum.Font.Code, 13, white, black, 0
        item.Size, item.TextXAlignment, item.TextYAlignment = UDim2.fromOffset(200,18), Enum.TextXAlignment.Left, Enum.TextYAlignment.Top
    elseif kind == 'Square' then
        stroke = Instance.new('UIStroke'); stroke.Color, stroke.Thickness, stroke.Parent = white, 1, item
    end
    local state = {Visible = false, Position = Vector2.zero, Size = Vector2.zero, From = Vector2.zero, To = Vector2.zero, Color = white, Transparency = 1, Filled = kind == 'Bar' or kind == 'Line', Thickness = 1, Text = '', Center = false, Native = native, Object = item, Kind = kind}
    if native then native.Visible, native.Transparency, native.Color = false, 1, white
    elseif state.Filled then item.BackgroundTransparency = 0 end
    local proxy = {}
    local function line()
        local from, to = state.From or Vector2.zero, state.To or Vector2.zero
        local delta = to - from
        item.AnchorPoint, item.Position = Vector2.new(0.5,0.5), UDim2.fromOffset((from.X+to.X)/2,(from.Y+to.Y)/2)
        item.Size, item.Rotation = UDim2.fromOffset(delta.Magnitude,math.max(1,state.Thickness)), math.deg(atan2(delta.Y,delta.X))
    end
    local function remove() if native then native:Remove() else item:Destroy() end end
    return setmetatable(proxy,{
        __index = function(_,key)
            if key == 'Remove' or key == 'Destroy' then return remove end
            if key == 'TextBounds' then return kind == 'Text' and item.TextBounds or Vector2.zero end
            return state[key]
        end,
        __newindex = function(_,key,value)
            if state[key] == value then return end
            state[key] = value
            if native then native[key] = value; return end
            if key == 'Position' then item.Position = UDim2.fromOffset(value.X,value.Y)
            elseif key == 'Size' then
                if type(value) == 'number' then item.TextSize = value else item.Size = UDim2.fromOffset(math.max(0,value.X),math.max(0,value.Y)) end
            elseif key == 'Visible' then item.Visible = value
            elseif key == 'Color' then
                if kind == 'Text' then item.TextColor3 = value elseif kind == 'Image' then item.ImageColor3 = value else item.BackgroundColor3 = value; if stroke then stroke.Color = value end end
            elseif key == 'Transparency' then
                if kind == 'Text' then item.TextTransparency, item.TextStrokeTransparency = 1-value, 1-value
                elseif kind == 'Image' then item.ImageTransparency = 1-value
                else item.BackgroundTransparency = state.Filled and 1-value or 1; if stroke then stroke.Transparency = 1-value end end
            elseif key == 'Filled' then item.BackgroundTransparency = value and 1-state.Transparency or 1; if stroke then stroke.Enabled = not value end
            elseif key == 'Thickness' then if stroke then stroke.Thickness = value elseif kind == 'Line' then line() end
            elseif key == 'Text' then item.Text = value
            elseif key == 'Center' then item.AnchorPoint = value and Vector2.new(0.5,0) or Vector2.zero; item.TextXAlignment = value and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left
            elseif key == 'From' or key == 'To' then line()
            elseif key == 'ZIndex' then item.ZIndex = math.clamp(value,1,10000)
            elseif key == 'Data' then if type(value) == 'string' and value:sub(1,13) == 'rbxassetid://' then item.Image = value end
            end
        end
    })
end
local function getArmor(character)
    local body = character and character:FindFirstChild('BodyEffects')
    return body and body:FindFirstChild('Armor')
end
local function bind(record, character)
    for _, connection in ipairs(record.CharacterConnections or {}) do connection:Disconnect() end
    record.CharacterConnections = {}
    for _, adornment in pairs(record.Chams or {}) do adornment:Destroy() end
    record.Chams = {}
    if record.Highlight then record.Highlight:Destroy(); record.Highlight = nil end
    if record.ForceFieldBubble then record.ForceFieldBubble:Destroy(); record.ForceFieldBubble = nil end
    record.Character, record.Parts, record.LastHealth, record.LastArmor = character, {}, nil, nil
    local function refresh()
        record.Root = character and character:FindFirstChild('HumanoidRootPart')
        record.Anchor = character and (character:FindFirstChild('UpperTorso') or character:FindFirstChild('Torso') or record.Root)
        record.Humanoid = character and character:FindFirstChildOfClass('Humanoid')
        record.ArmorValue = getArmor(character)
        record.EquippedTool = character and character:FindFirstChildOfClass('Tool')
    end
    local function added(part)
        if part:IsA('BasePart') then record.Parts[part] = true end
        refresh()
    end
    local function removed(part)
        record.Parts[part] = nil
        local adornment = record.Chams and record.Chams[part]
        if adornment then adornment:Destroy(); record.Chams[part] = nil end
        refresh()
    end
    if character then
        for _, part in ipairs(character:GetDescendants()) do if part:IsA('BasePart') then record.Parts[part] = true end end
        record.CharacterConnections[1] = connect(character.DescendantAdded,added,record.Player,'unnamed character added',true)
        record.CharacterConnections[2] = connect(character.DescendantRemoving,removed,record.Player,'unnamed character removed',true)
        record.CharacterConnections[3] = connect(character.ChildRemoved,refresh,record.Player,'unnamed tool removed',true)
        record.CharacterConnections[4] = connect(character.ChildAdded,refresh,record.Player,'unnamed tool added',true)
    end
    refresh()
end
function utility.funcs.render(player, record)
    if record.Drawings then return end
    record.Drawings, record.Gradients, record.Chams = {}, {}, {}
    local draws = record.Drawings
    for _, name in ipairs({'Box','BoxOutline','BoxInline'}) do draws[name] = drawing('Square'); draws[name].ZIndex = 3 end
    for _, name in ipairs({'Name','Distance','ToolText','HealthText','WantedText','ForceFieldText','CrewText','CrewCount'}) do draws[name] = drawing('Text'); draws[name].ZIndex = 5; draws[name].Center = name == 'Name' or name == 'Distance' or name == 'ToolText' or name == 'CrewText' end
    for _, kind in ipairs({'Health','Armor'}) do
        draws[kind .. 'BarOutline'], draws[kind .. 'Bar'] = drawing('Bar'), drawing('Bar')
        draws[kind .. 'BarOutline'].ZIndex, draws[kind .. 'Bar'].ZIndex = 3, 4
        local gradient = Instance.new('UIGradient')
        gradient.Rotation, gradient.Parent = 90, draws[kind .. 'Bar'].Object
        record.Gradients[kind] = gradient
    end
    draws.Tracer, draws.TracerOutline, draws.Image, draws.WeaponIcon, draws.CrewIcon = drawing('Line'), drawing('Line'), drawing('Bar'), drawing('Image'), drawing('Image')
    local gradient = Instance.new('UIGradient')
    gradient.Rotation, gradient.Parent = 90, draws.Image.Object
    gradient.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0,1),NumberSequenceKeypoint.new(1,0)})
    record.ImageGradient = gradient
    draws.Tracer.ZIndex, draws.TracerOutline.ZIndex = 3, 2
    draws.Image.ZIndex, draws.WeaponIcon.ZIndex, draws.CrewIcon.ZIndex = 1, 5, 5
    draws.BoxOutline.Color, draws.BoxInline.Color, draws.HealthBarOutline.Color, draws.ArmorBarOutline.Color = black, black, black, black
end
