Players.PlayerRemoving:Connect(function(Player)
    local PlayerData = Data[Player]

    if not PlayerData then
        return
    end

    PlayerData.Character = nil
    FadeOut(PlayerData)

    task.delay(0.8, function()
        if not Data[Player] then
            return
        end

        for _, Connection in PlayerData.Connections do
            if Connection then
                Connection:Disconnect()
            end
        end

        for _, Drawing in PlayerData.Drawings do
            if Drawing then
                Drawing:Remove()
            end
        end

        for _, Cham in PlayerData.Chams do
            if Cham then
                Cham:Destroy()
            end
        end

        if PlayerData.Highlight then
            PlayerData.Highlight:Destroy()
        end

        Data[Player] = nil
    end)
end)

Players.PlayerAdded:Connect(function(Player)
    Player.CharacterAdded:Connect(function(Character)
        local PlayerData = Data[Player]

        if PlayerData then
            PlayerData.Character = Character
            PlayerData.Humanoid = Character:WaitForChild("Humanoid")
            PlayerData.Root = Character:WaitForChild("HumanoidRootPart")

            PlayerData.Fake_Health = PlayerData.Humanoid.Health
            PlayerData.Fake_Armor = 0

            if ESP.Settings.Chams.Enabled then
                Update_Chams(PlayerData)
            end

            if ESP.Settings.Highlight.Enabled then
                Update_Highlight(PlayerData, Player)
            end

            FadeIn(PlayerData)
        end
    end)
end)

