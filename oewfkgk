local GetOrigin = LPH_NO_VIRTUALIZE(function()
    local ViewPort = Camera.ViewportSize
    if ESP.Settings.Tracer.Origin == "Above" then
        return Vector2.new(ViewPort.X / 2, 0)
    elseif ESP.Settings.Tracer.Origin == "Mouse" then
        return Vector2.new(UserInputService:GetMouseLocation().X, UserInputService:GetMouseLocation().Y)
    elseif ESP.Settings.Tracer.Origin == "Center" then
        return Vector2.new(ViewPort.X / 2, ViewPort.Y / 2)
    elseif ESP.Settings.Tracer.Origin == "Below" then
        return Vector2.new(ViewPort.X / 2, ViewPort.Y)
    end
end)

