local function LerpColors(ColorList, Offset)
    local Index = math.floor(Offset * #ColorList) + 1
    local NextIndex = (Index % #ColorList) + 1
    local Alpha = (Offset * #ColorList) % 1
    return ColorList[Index]:Lerp(
        ColorList[NextIndex],
        Alpha
    )
end
