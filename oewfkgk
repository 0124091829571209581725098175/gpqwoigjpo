            if Drawings.BoxTop then
                Drawings.BoxTop.Color = ESP.Settings.Box.Colors.Top
                Drawings.BoxRight.Color = ESP.Settings.Box.Colors.Right
                Drawings.BoxBottom.Color = ESP.Settings.Box.Colors.Bottom
                Drawings.BoxLeft.Color = ESP.Settings.Box.Colors.Left
