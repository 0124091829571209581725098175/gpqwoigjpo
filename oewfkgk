local Tween
local Heartbeats = {}
local Active_Tweens = {
    Color = {},
    Color3 = {},
    Size = {},
    tween_position = {},
    Position = {},
    tween_size = {},
    Transparency = {},
    FillTransparency = {},
    OutlineTransparency = {},
    BackgroundTransparency = {},
    ImageTransparency = {},
    FillColor = {},
    OutlineColor = {},
    
    Fake_Health = {},
    Fake_Armor = {},

    [11] = {},
    [15] = {}
}

do
    local Sqrt = math.sqrt

    Tween = LPH_NO_VIRTUALIZE(function(Object, Properties, EasingStyle, _, TweenDuration)
        local StartTime = os.clock()

        local TweenFunctions = {}
        
        for Property, TargetValue in Properties do
        	local ActiveTween = Active_Tweens[Property][Object]
        	if ActiveTween then
        		for Index = 1, # Heartbeats do
        			if Heartbeats[Index] == ActiveTween then
        				table.remove(Heartbeats, Index)
        				break
        			end
        		end
        	end
        	local StartValue = Object[Property]
        	if Property == "Color" or Property == "Color3" or Property == "FillColor" or Property == "OutlineColor" then
        		TweenFunctions[Property] = function()
        			local Alpha = (os.clock() - StartTime) / TweenDuration
        			local EasedAlpha = EasingStyle == Enum.EasingStyle.Exponential and (Alpha == 1 and 1 or 1 - 2 ^ (-10 * Alpha)) or EasingStyle == Enum.EasingStyle.Quad and Alpha ^ 2 or Sqrt(1 - (Alpha - 1) ^ 2)
        			if EasingStyle == "Sine" then
        				Alpha = math.clamp(Alpha, 0, 1)
        				EasedAlpha = Alpha < 0.5 and 0.5 * math.sin(Alpha * 355 / 113) or 0.5 + 0.5 * (1 - math.cos((Alpha - 0.5) * 355 / 113))
        			end
        			Object[Property] = Color3.fromRGB["Lerp"](StartValue, TargetValue, EasedAlpha)
        		end
        	elseif Property == "tween_position" or Property == "tween_size" then
        		TweenFunctions[Property] = function()
        			local Alpha = (os.clock() - StartTime) / TweenDuration
        			local EasedAlpha = EasingStyle == Enum.EasingStyle.Exponential and (Alpha == 1 and 1 or 1 - 2 ^ (-10 * Alpha)) or EasingStyle == Enum.EasingStyle.Quad and Alpha ^ 2 or Sqrt(1 - (Alpha - 1) ^ 2)
        			local Delta = TargetValue - StartValue
        			Delta = UDim2.new(
                                Delta.X.Scale * EasedAlpha, Delta.X.Offset * EasedAlpha, Delta.Y.Scale * EasedAlpha, Delta.Y.Offset * EasedAlpha)
        			Object[Property] = StartValue + Delta
        		end
        	else
        		TweenFunctions[Property] = function()
        			local Alpha = (os.clock() - StartTime) / TweenDuration
        			local EasedAlpha = EasingStyle == Enum.EasingStyle.Exponential and (Alpha == 1 and 1 or 1 - 2 ^ (-10 * Alpha)) or EasingStyle == Enum.EasingStyle.Quad and Alpha ^ 2 or Sqrt(1 - (Alpha - 1) ^ 2)
        			Object[Property] = StartValue + (TargetValue - StartValue) * EasedAlpha
        		end
        	end
        end

        for Property, TweenFunction in TweenFunctions do
            Heartbeats[#Heartbeats + 1] = TweenFunction
            Active_Tweens[Property][Object] = TweenFunction
        end

        task.delay(TweenDuration, function()
            for Property, TweenFunction in TweenFunctions do
                for Index = 1, #Heartbeats do
                    if Heartbeats[Index] == TweenFunction then
                        table.remove(Heartbeats, Index)

                        Object[Property] = Properties[Property]
                        break
                    end
                end
            end
        end)
    end)
end

local function FadeIn(Data)
    if Data.Fading then
        return
    end

    Data.Fading = true

    for _, Drawing in Data.Drawings do
        if Drawing then
            Drawing.Visible = true
            Drawing.Transparency = 0
        end
    end

    task.delay(0.05, function()
        for _, Drawing in Data.Drawings do
            if Drawing then
                Tween(Drawing, {
                    Transparency = 1
                }, Enum.EasingStyle.Quad, Out, 0.75)
            end
        end
    end)

    if Data.Highlight then
        Data.Highlight.Enabled = true
        Data.Highlight.FillTransparency = 1
        Data.Highlight.OutlineTransparency = 1

        TweenService:Create(
            Data.Highlight,
            TweenInfo.new(0.75, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {
                FillTransparency = Alt_Information[2],
                OutlineTransparency = Alt_Information[4]
            }
        ):Play()
    end

    task.delay(0.3, function()
        Data.Rendering = true
        Data.Fading = false
    end)
end

local function FadeOut(Data)
    if Data.Fading then
        return
    end

    Data.Fading = true

    task.delay(0.05, function()
        for _, Drawing in Data.Drawings do
            if Drawing then
                Tween(Drawing, {
                    Transparency = 0
                }, Enum.EasingStyle.Quad, Out, 0.75)
            end
        end
    end)

    if Data.Highlight then
        TweenService:Create(
            Data.Highlight,
            TweenInfo.new(0.75, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
            {
                FillTransparency = 1,
                OutlineTransparency = 1
            }
        ):Play()
    end

    task.delay(0.75, function()
        for _, Drawing in Data.Drawings do
            if Drawing then
                Drawing.Visible = false
            end
        end

        if Data.Highlight then
            Data.Highlight.Enabled = false
        end

        Data.Rendering = false
        Data.Fading = false
    end)
end

