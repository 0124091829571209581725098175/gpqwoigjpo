function ESP:Refresh()
    for Player, PlayerData in pairs(Data) do
        local WasRendering = PlayerData.Rendering

        local OldDrawings = PlayerData.Drawings
        local OldChams = PlayerData.Chams
        local OldHighlight = PlayerData.Highlight

        PlayerData.Drawings = {}
        PlayerData.Chams = {}
        PlayerData.Highlight = nil

        Create_ESP(PlayerData)

        PlayerData.Rendering = WasRendering

        for _, Drawing in pairs(OldDrawings) do
            if Drawing then
                Drawing:Remove()
            end
        end

        for _, Cham in pairs(OldChams) do
            if Cham then
                Cham:Destroy()
            end
        end

        if OldHighlight then
            OldHighlight:Destroy()
        end
    end
end

function ESP:Update_ESP_Color()
    for Player, PlayerData in pairs(Data) do
        local Drawings = PlayerData.Drawings

        if Drawings then
            if Drawings.Name then
                Drawings.Name.Color = ESP.Settings.Name.Color
            end

            if Drawings.BoxTop then
                Drawings.BoxTop.Color = ESP.Settings.Box.Colors.Top
                Drawings.BoxRight.Color = ESP.Settings.Box.Colors.Right
                Drawings.BoxBottom.Color = ESP.Settings.Box.Colors.Bottom
                Drawings.BoxLeft.Color = ESP.Settings.Box.Colors.Left
            end

            if Drawings.Distance then
                Drawings.Distance.Color = ESP.Settings.Distance.Color
            end

            if Drawings.ToolText then
                Drawings.ToolText.Color = ESP.Settings.ToolText.Color
            end

            if Drawings.HealthText then
                Drawings.HealthText.Color = ESP.Settings.HealthText.Color
            end

            if Drawings.Tracer then
                Drawings.Tracer.Color = ESP.Settings.Tracer.Color
            end

            if Drawings.TracerOutline then
                Drawings.TracerOutline.Color = ESP.Settings.Tracer.OutlineColor
            end
        end

        if PlayerData.Chams then
            for _, Cham in pairs(PlayerData.Chams) do
                if Cham then
                    Cham.Color3 = ESP.Settings.Chams.Color
                    Cham.Transparency = ESP.Settings.Chams.Transparency
                end
            end
        end

        if PlayerData.Highlight then
            PlayerData.Highlight.FillColor = ESP.Settings.Highlight.FillColor
            PlayerData.Highlight.OutlineColor = ESP.Settings.Highlight.OutlineColor
            PlayerData.Highlight.FillTransparency = ESP.Settings.Highlight.FillTransparency
            PlayerData.Highlight.OutlineTransparency = ESP.Settings.Highlight.OutlineTransparency
        end
    end
end

function ESP:Configure(Config)
    local function Merge(Target, Source)
        for Index, Value in pairs(Source) do
            if type(Value) == "table" and type(Target[Index]) == "table" then
                Merge(Target[Index], Value)
            else
                Target[Index] = Value
            end
        end
    end

    local ColorOnly = true

    local function CheckColorOnly(Table)
        for Key, Value in pairs(Table) do
            if type(Value) == "table" then
                if not CheckColorOnly(Value) then
                    return false
                end
            elseif typeof(Value) ~= "Color3" and Key ~= "FillTransparency" and Key ~= "OutlineTransparency" then
                return false
            end
        end

        return true
    end

    if not CheckColorOnly(Config) then
        ColorOnly = false
    end

    Merge(self.Settings, Config)

    if ColorOnly then
        self:Update_ESP_Color()
    else
        self:Refresh()
    end
end
