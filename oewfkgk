local function SyncConnections(PlayerData)
    for _, Connection in PlayerData.Connections do
        if Connection then
            Connection:Disconnect()
        end
    end
    PlayerData.Connections = {}
    local Character = PlayerData.Character
    local Humanoid = PlayerData.Humanoid
    if Humanoid then
        PlayerData.Connections.Died = Humanoid.Died:Connect(function()
            FadeOut(PlayerData)
        end)
        if ESP.Settings.Bars.Health.Enabled then
            PlayerData.Connections.Health = Humanoid.HealthChanged:Connect(function(NewHealth)
                Update_Health_Bar(PlayerData, NewHealth, math.abs(NewHealth - PlayerData.Fake_Health))
            end)
        end
        if ESP.Settings.Bars.Health.Enabled or ESP.Settings.HealthText.Enabled then
            PlayerData.Connections.MaxHealth = Humanoid:GetPropertyChangedSignal("MaxHealth"):Connect(function()
                PlayerData.Fake_MaxHealth = Humanoid.MaxHealth
            end)
        end
        if ESP.Settings.HealthText.Enabled then
            PlayerData.Connections.HealthText = Humanoid.HealthChanged:Connect(function(NewHealth)
                Update_Health_Text(PlayerData, math.floor(NewHealth))
            end)
        end
    end
    if ESP.Settings.Bars.Armor.Enabled and PlayerData.ArmorValue then
        PlayerData.Connections.Armor = PlayerData.ArmorValue:GetPropertyChangedSignal("Value"):Connect(function()
            local NewArmor = PlayerData.ArmorValue.Value
            Update_Armor_Bar(PlayerData, NewArmor, math.abs(NewArmor - PlayerData.Fake_Armor))
        end)
    end
    if Character then
        PlayerData.EquippedTool = FindEquippedTool(Character)
        PlayerData.ToolKey = IconKey(PlayerData.EquippedTool and PlayerData.EquippedTool.Name or nil)
        if ESP.Settings.ToolText.Enabled then
            Update_Tool_Text(PlayerData, PlayerData.EquippedTool)
        end
        PlayerData.Connections.ToolAdded = Character.ChildAdded:Connect(function(Child)
            if Child:IsA("Tool") then
                PlayerData.EquippedTool = Child
                PlayerData.ToolKey = IconKey(Child.Name)
                if ESP.Settings.ToolText.Enabled then
                    Update_Tool_Text(PlayerData, Child)
                end
            end
        end)
        PlayerData.Connections.ToolRemoved = Character.ChildRemoved:Connect(function(Child)
            if Child:IsA("Tool") then
                local Current = FindEquippedTool(Character)
                PlayerData.EquippedTool = Current
                PlayerData.ToolKey = IconKey(Current and Current.Name or nil)
