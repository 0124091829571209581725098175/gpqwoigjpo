function ESP:Refresh()
    for Player, PlayerData in pairs(Data) do
        pcall(function()
        local WasRendering = PlayerData.Rendering
        local OldDrawings = PlayerData.Drawings
        local OldChams = PlayerData.Chams
        local OldHighlight = PlayerData.Highlight
        PlayerData.Drawings = {}
        PlayerData.Chams = {}
        PlayerData.Highlight = nil
        local Character = Player.Character or PlayerData.Character
        if Character then
            PlayerData.Character = Character
            PlayerData.Humanoid = Character:FindFirstChildOfClass("Humanoid") or PlayerData.Humanoid
            PlayerData.Anchor = GetAnchor(Character)
            PlayerData.Root = Character:FindFirstChild("HumanoidRootPart")
            PlayerData.ArmorValue = GetArmorValue(Character)
            if PlayerData.Humanoid then
                PlayerData.Fake_Health = PlayerData.Humanoid.Health
                PlayerData.Fake_MaxHealth = PlayerData.Humanoid.MaxHealth
            end
            PlayerData.Fake_Armor = PlayerData.ArmorValue and PlayerData.ArmorValue.Value or 0
        end
        PlayerData.LastH = nil
        PlayerData.LastW = nil
        PlayerData.LastHP = nil
        PlayerData.LastAP = nil
        PlayerData.LastMH = nil
        PlayerData.ChamsChar = PlayerData.Character
        Create_ESP(PlayerData)
        SyncConnections(PlayerData)
        PlayerData.Rendering = WasRendering
        for _, Drawing in pairs(OldDrawings) do
            if Drawing then
                Drawing:Remove()
            end
        end
        for _, Entry in pairs(OldChams) do
            if Entry and Entry.Adornment then
                Entry.Adornment:Destroy()
            end
        end
        if OldHighlight then
            OldHighlight:Destroy()
        end
        end)
    end
end
function ESP:Update_ESP_Color()
    for Player, PlayerData in pairs(Data) do
