RunService.Heartbeat:Connect(function()
    for _, Player in Players:GetPlayers() do
        if Player ~= LocalPlayer and Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
            local Character = Player.Character
            local Humanoid = Character:FindFirstChildOfClass("Humanoid")
            if not Humanoid then
                continue
            end
            
            local BodyEffects = Character:FindFirstChild("BodyEffects") or nil
            local BodyArmor = nil
            if BodyEffects then
                BodyArmor = BodyEffects and BodyEffects:FindFirstChild("Armor")
            end

            local PlayerData = Data[Player]    
            if not PlayerData then
                PlayerData = {
                    Player = Player,
                
                    Character = Character,
                    Humanoid = Humanoid,
                    UpperTorso = Character:FindFirstChild("UpperTorso"),
                    Root = Character:FindFirstChild("HumanoidRootPart"),

                    ArmorValue = BodyArmor,
                
                    Fake_Health = Humanoid.Health,
                    Fake_Armor = BodyArmor and BodyArmor.Value or 0,
                
                    Tracer_Thickness = 2,
                    Tracer_Outline_Thickness = 1,

                    Hide_Tags = false,

                    Rendering = false,
                    Fading = false,
                
                    Drawings = {},
                    Chams = {},
                
                    Connections = {},
                
                    Cache = {}
                }
    
                Data[Player] = PlayerData
    
                Create_ESP(PlayerData)
                FadeIn(PlayerData)

                if ESP.Settings.Character.Hide_Tags then
                    local Hide_Tags = LPH_NO_VIRTUALIZE(function()
                        local Humanoid = PlayerData.Humanoid

                        if Humanoid then
                            Humanoid.DisplayName = "‎"
                            Humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
                        end
                    end)

                    PlayerData.Connections.NameTags =
                        PlayerData.Player.CharacterAdded:Connect(function()
                            PlayerData.Fake_Health = PlayerData.Humanoid.Health
                            PlayerData.Fake_Armor = 0

                            Hide_Tags()
                        end)

                    Hide_Tags()
                end

                PlayerData.Connections.Died =
                    Humanoid.Died:Connect(function()
                        FadeOut(PlayerData)
                    end)

                if ESP.Settings.Bars.Health.Enabled then
                    PlayerData.Connections.Health =
                        PlayerData.Humanoid.HealthChanged:Connect(function(NewHealth)
                            Update_Health_Bar(
                                PlayerData,
                                NewHealth,
                                math.abs(NewHealth - PlayerData.Fake_Health)
                            )
                        end)
                end
                
                if ESP.Settings.HealthText.Enabled then
                    PlayerData.Connections.HealthText =
                        PlayerData.Humanoid.HealthChanged:Connect(function(NewHealth)
                            Update_Health_Text(PlayerData,
                                math.floor(NewHealth)
                            )
                        end)
                end
                
                if ESP.Settings.Bars.Armor.Enabled and PlayerData.ArmorValue then
                    PlayerData.Connections.Armor =
                        PlayerData.ArmorValue:GetPropertyChangedSignal("Value"):Connect(function()
                            local NewArmor = PlayerData.ArmorValue.Value
                            Update_Armor_Bar(
                                PlayerData,
                                NewArmor,
                                math.abs(NewArmor - PlayerData.Fake_Armor)
                            )
                        end)
                end
                
                if ESP.Settings.ToolText.Enabled then
                    PlayerData.Connections.ToolText =
                        PlayerData.Character.ChildAdded:Connect(function(Child)
                            if Child:IsA("Tool") then
                                Update_Tool_Text(PlayerData, Child, Player)
                            end
                        end)

                    for _, Child in pairs(PlayerData.Character:GetChildren()) do
                        if Child:IsA("Tool") then
                            Update_Tool_Text(PlayerData, Child, Player)
                        end
                    end
                end
                
                if ESP.Settings.Chams.Enabled then
                    Update_Chams(PlayerData)
                end
                
                if ESP.Settings.Highlight.Enabled then
                    Update_Highlight(PlayerData, Player)
                end
            end

            PlayerData.Character = Character
            PlayerData.Humanoid = Humanoid
            PlayerData.UpperTorso = Character:FindFirstChild("UpperTorso")
            PlayerData.Root = Character:FindFirstChild("HumanoidRootPart")
            if not table.find(Heartbeats, Update_ESP) then
                Heartbeats[#Heartbeats + 1] = Update_ESP
            end
       end
    end
end)

