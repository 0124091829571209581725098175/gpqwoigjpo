local function LerpColors(Colors, Offset)
    local Index = math.floor(Offset * #Colors) + 1
    local NextIndex = (Index % #Colors) + 1

    local Alpha = (Offset * #Colors) % 1

    return Colors[Index]:Lerp(
        Colors[NextIndex],
        Alpha
    )
end

