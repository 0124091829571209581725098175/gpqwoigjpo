function ESP:Configure(Config)
    local function Merge(Target, Source)
        for Index, Value in pairs(Source) do
            if type(Value) == "table" and type(Target[Index]) == "table" then
                Merge(Target[Index], Value)
            else
                Target[Index] = Value
            end
        end
    end
    local ColorOnly = true
    local function CheckColorOnly(Table)
        for Key, Value in pairs(Table) do
            if type(Value) == "table" then
                if not CheckColorOnly(Value) then
                    return false
                end
            elseif typeof(Value) ~= "Color3" and Key ~= "FillTransparency" and Key ~= "OutlineTransparency" then
                return false
            end
        end
        return true
    end
    if not CheckColorOnly(Config) then
        ColorOnly = false
    end
    Merge(self.Settings, Config)
    if ColorOnly then
        self:Update_ESP_Color()
    else
        self:Refresh()
    end
end
