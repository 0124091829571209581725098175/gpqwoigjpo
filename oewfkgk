local Update_Armor_Bar = LPH_NO_VIRTUALIZE(function(Data, New_Armor, Difference)
    if ESP.Settings.Bars.Armor.Hide_If_Empty and New_Armor == 0 then
        Data.Drawings.ArmorBar.Size = ESP.Settings.Misc.ZeroSize
        Data.Drawings.ArmorBarOutline.Size = ESP.Settings.Misc.ZeroSize

        if ESP.Settings.Bars.Armor.Gradient then
            Data.Drawings.ArmorBarGradient.Size = ESP.Settings.Misc.ZeroSize
        end

        Data.Fake_Armor = 0
        return
    elseif Difference <= 1 then
        Data.Fake_Armor = New_Armor
        return
    end
    
    Data.Fake_Armor = math.floor(New_Armor)
end)

local Create_Chams = LPH_NO_VIRTUALIZE(function(Data)
    local Chams_ = {}
    local Culling_Mode = Enum.AdornCullingMode.Automatic

    for Index = 1, #Body_Parts do
        local Body_Part = Body_Parts[Index]
        local Character_Part = Data.Character and Data.Character:FindFirstChild(Body_Part)

        if Character_Part then
            Chams_[#Chams_ + 1] = Create_Instance("BoxHandleAdornment", {
                Visible = true,
                Adornee = Character_Part,
                Transparency = ESP.Settings.Chams.Transparency,
                AdornCullingMode = Culling_Mode,
                Archivable = true,
                Color3 = ESP.Settings.Chams.Color,
                ZIndex = ESP.Settings.Chams.ZIndex,
                AlwaysOnTop = true,
                Size = Character_Part.Size + ESP.Settings.Chams.Offset,
                Parent = CoreGui
            })
        end
    end

    Data.Chams = Chams_
end)

local Update_Chams = LPH_NO_VIRTUALIZE(function(Data)
    for Index, Cham in Data.Chams do
        local PartName = Body_Parts[Index]
        local Part = Data.Character and Data.Character:FindFirstChild(PartName)

        if Cham and Part then
            Cham.Adornee = Part
            Cham.Size = Part.Size + ESP.Settings.Chams.Offset
        end
    end
end)

